---
interface Props {
  title: string;
  subtitle?: string;
  alignment?: "left" | "center";
}

const { title, subtitle, alignment = "center" } = Astro.props;

const alignmentClasses = {
  left: "text-left",
  center: "text-center",
};
---

<div class={`${alignmentClasses[alignment]}`}>
  <h2 class="text-pretty text-2xl font-semibold text-dark sm:text-3xl lg:text-4xl">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 text-pretty text-sm text-dark/80 sm:text-base">
      {subtitle}
    </p>
  )}
</div>
