---
import { siteConfig } from "../../data/siteConfig";
const { outcomes, modalities } = siteConfig;
---

<!-- Approach -->
<div class="bg-neutral-900">
    <!-- Approach -->
    <div class="max-w-5xl px-4 xl:px-0 py-10 lg:pt-20 lg:pb-20 mx-auto">
      <!-- Title -->
      <div class="flex flex-col gap-6 lg:flex-row lg:gap-10 mb-10">
        <div class="flex-1">
          <h2 class="text-white font-semibold text-2xl md:text-4xl md:leading-tight">
            {outcomes.heading}
          </h2>
          {outcomes.items.map((item) => (
            <p class="mt-1 text-base bg-accent text-primary rounded-md p-2 text-center">{item}</p>
          ))}
        </div>
      
        <div class="flex-1">
          <h2 class="text-white font-semibold text-2xl md:text-4xl md:leading-tight">
            {modalities.heading}
          </h2>
          {modalities.items.map((item) => (
            <p class="mt-1 text-base bg-accent text-primary rounded-md p-2 text-center">{item}</p>
          ))}
        </div>
      </div>
      <!-- End Title -->

      <!-- divider start   -->
      <span class="flex items-center mb-10">
        <span class="h-px flex-1 bg-gray-300"></span>
      
        <span class="shrink-0 px-4 text-base ">Schedule</span>
      
        <span class="h-px flex-1 bg-gray-300"></span>
      </span>
       <!-- divider end -->
  
      <!-- Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 lg:items-center">
        <div class="aspect-w-16 aspect-h-9 lg:aspect-none">
          <img class="w-full object-cover rounded-xl" src="https://images.unsplash.com/photo-1587614203976-365c74645e83?q=80&w=480&h=600&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Features Image">
        </div>
        <!-- End Col -->
  
        <!-- Timeline -->
        <div>
            <!-- Heading -->
            <div class="mb-6">
              <h3 class="text-[#ff0] text-xs font-medium uppercase">
                Schedule
              </h3>
            </div>
            <!-- End Heading -->
          
            {siteConfig.schedule.map((item, index) => (
              <div class="flex gap-x-5 ms-1">
                <!-- Timeline Icon / Line -->
                <div class="relative last:after:hidden after:absolute after:top-8 after:bottom-0 after:start-4 after:w-px after:-translate-x-[0.5px] after:bg-neutral-800">
                  <div class="relative z-10 size-8 flex justify-center items-center">
                    <span class="flex shrink-0 justify-center items-center size-8 border border-neutral-800 text-[#ff0] font-semibold text-xs uppercase rounded-full">
                      {index + 1}
                    </span>
                  </div>
                </div>
                <!-- End Icon -->
          
                <!-- Content -->
                <div class="grow pt-0.5 pb-8 sm:pb-12">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs uppercase tracking-wide text-neutral-500">
                      {item.day} · {item.time}
                    </span>
          
                    <p class="text-sm lg:text-base text-neutral-400">
                      <span class="text-white font-medium">
                        {item.title}:
                      </span>{' '}
                      {item.description}
                    </p>
                  </div>
                </div>
                <!-- End Content -->
              </div>
            ))}
          </div>
        <!-- End Timeline -->
      </div>
      <!-- End Grid -->
    </div>
  </div>
  <!-- End Approach -->