---
import { siteConfig } from "../../data/siteConfig";
const { about} = siteConfig;
import Button from "../ui/Button.astro";
---


<!-- Features -->
<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto bg-secondary">
  <h3 class="text-2xl font-bold text-primary text-center mb-5 font-heading">Men Advancing Together in Every Arena of Life.</h2>
    <div class="aspect-w-16 aspect-h-7">
      <img class="w-full object-cover rounded-xl" src="src/assets/images/features/NC1.jpeg" alt="Features Image">
    </div>
  
    <!-- Grid -->
    <div class="mt-5 lg:mt-16 grid lg:grid-cols-3 gap-8 lg:gap-12">
      <div class="lg:col-span-1">
        <h2 class="font-bold text-2xl md:text-3xl text-primary text-center font-heading">
          A private mountain retreat just outside Asheville, NC.
        </h2>
        <p class="mt-2 md:mt-4 text-base">
          {about.paragraphs[0]} The retreat includes the following:
        </p>
      </div>
      <!-- End Col -->
  
      <div class="lg:col-span-2">
        <div class="grid sm:grid-cols-2 gap-8 md:gap-12">
          <!-- Icon Block -->
          {siteConfig.features.map((feature) => (
            <div class="flex gap-x-5 bg-dark rounded-lg p-4">
              {/* Replace this with your SVG or render feature.icon if you switch to inline SVG strings */}
              <div class="grow">
                <h3 class="text-lg font-semibold text-primary font-heading">
                  {feature.title}
                </h3>
                <p class="mt-1 text-base">
                  {feature.description}
                </p>
              </div>
            </div>
          ))}
        </div>
        <div class="flex justify-center mt-5">

          <Button label="Book A Call Today" href="#tbd" variant="secondary" />
        </div>
      </div>
      <!-- End Col -->
    </div>
    <!-- End Grid -->
  </div>
  <!-- End Features -->