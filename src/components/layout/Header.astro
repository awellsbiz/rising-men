---
import { siteConfig } from "../../data/siteConfig";
const { brand, nav } = siteConfig;
const hasLogo = Boolean(brand.logo && brand.logo !== "TBD");
---

<header class="sticky top-0 inset-x-0 z-50 w-full text-sm">
  <nav
    class="mt-4 relative mx-2 w-full max-w-5xl rounded-[24px] border border-dark/20 bg-base/95 p-1 pl-4 shadow-sm backdrop-blur sm:mx-auto md:py-0"
    aria-label="Primary"
  >
    <div class="flex items-center justify-between">
      <a
        class="inline-flex items-center gap-2 rounded-md text-base font-semibold text-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        href="/"
        aria-label={brand.name}
      >
        {hasLogo ? (
          <img
            src={brand.logo}
            alt={brand.name}
            class="h-8 w-auto"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span>{brand.name}</span>
        )}
      </a>

      <div class="flex items-center md:hidden">
        <button
          type="button"
          class="hs-collapse-toggle inline-flex size-9 items-center justify-center rounded-full border border-dark/20 text-dark/70 transition hover:bg-primary/10 hover:text-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          id="primary-nav-toggle"
          aria-expanded="false"
          aria-controls="primary-nav"
          aria-label="Toggle navigation"
          data-hs-collapse="#primary-nav"
        >
          <svg
            class="hs-collapse-open:hidden size-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            class="hs-collapse-open:block hidden size-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="primary-nav"
      class="hs-collapse hidden overflow-hidden transition-all duration-300 md:block"
      aria-labelledby="primary-nav-toggle"
    >
      <div class="mt-3 flex flex-col gap-2 border-t border-dark/10 px-3 pb-4 pt-3 md:mt-0 md:flex-row md:items-center md:justify-end md:border-t-0 md:px-0 md:pb-0 md:pt-0 md:pr-4">
        {nav.map((item) => (
          <a
            class="rounded-md px-3 py-2 text-sm font-medium text-dark/80 transition-colors hover:bg-primary/10 hover:text-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent md:bg-transparent md:hover:bg-transparent"
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>
